{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lista-do-mercado",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Sem URLs de pré-visualização: só existe uma versão no ar, a oficial.
  "preview_urls": false,
  // O site é servido direto pela Cloudflare (grátis e sem limite); só /api passa pelo Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lista-do-mercado",
      "database_id": "aecc4608-79a5-4055-805d-2ed9df6cd819",
      "migrations_dir": "server/db/migrations"
    }
  ],
  // Workers AI (plano grátis): lê a foto do cupom fiscal.
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY_EVENTS", "class_name": "FamilyEvents" }]
  },
  // O plano grátis só aceita Durable Objects com SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyEvents"] }],
  "observability": { "enabled": true }
}
