{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lista-do-mercado",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  // O site é servido direto pela Cloudflare (grátis e sem limite); só /api passa pelo Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lista-do-mercado",
      // Trocado pelo id real ao criar o banco com `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FAMILY_EVENTS", "class_name": "FamilyEvents" }]
  },
  // O plano grátis só aceita Durable Objects com SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyEvents"] }],
  "observability": { "enabled": true }
}
