# Tudo é opcional. Copie para .env se precisar mudar algum valor.

# Porta do servidor.
PORT=3000

# Pasta do banco SQLite e dos backups.
DATA_DIR=data

# Endereço público do app, usado nos links de convite gerados no terminal.
# Com npm run dev, use http://localhost:5173.
APP_URL=http://localhost:3000
