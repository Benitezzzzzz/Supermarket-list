{
  "name": "lista-do-mercado",
  "private": true,
  "version": "4.14.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"wrangler dev\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "db:migrate": "wrangler d1 migrations apply lista-do-mercado --local",
    "db:migrate:remote": "wrangler d1 migrations apply lista-do-mercado --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "user:reset-password": "node server/scripts/reset-password.ts",
    "user:set-superadmin": "node server/scripts/set-superadmin.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zxing-wasm": "^2.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
