{
  "name": "lista-do-mercado",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "family:create": "node --env-file-if-exists=.env server/scripts/create-family.ts",
    "backup": "node --env-file-if-exists=.env server/scripts/backup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
